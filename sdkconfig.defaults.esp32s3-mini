# ESP32-S3-Zero (Waveshare) — 4MB Flash / 2MB PSRAM (Quad SPI)
CONFIG_BOARD_ESP32S3_GENERIC=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="components/boards/partitions-4m.csv"

# GPIO defaults for Waveshare ESP32-S3-Zero
# Pinout: 3v3, GPIO2(n/c), GPIO3(BCK), GPIO4(DIN), GPIO5(LCK), GPIO6(sw GND)
# PCM5102 SCK is jumped to GND on the DAC board; route MCLK to an unconnected
# pin (GPIO8) so the I2S clock tree operates normally.
CONFIG_BAT_CHANNEL=7
CONFIG_LED_RGB_GPIO=21
CONFIG_I2S_SCK_IO=8
CONFIG_I2S_BCK_IO=3
CONFIG_I2S_WS_IO=5
CONFIG_I2S_DO_IO=4
CONFIG_I2S_GND_IO=6
